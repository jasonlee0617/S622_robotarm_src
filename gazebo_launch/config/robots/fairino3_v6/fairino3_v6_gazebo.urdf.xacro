<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fairino3_v6_robot">
  <xacro:arg name="initial_positions_file" default="$(find fairino3_v6_moveit2_config)/config/initial_positions.yaml"/>
  <xacro:arg name="controllers_file" default="$(find fairino3_v6_moveit2_config)/config/ros2_controllers.yaml"/>
  <xacro:arg name="enable_camera" default="false"/>

  <xacro:include filename="$(find fairino_description)/urdf/fairino3_v6.urdf"/>
  <xacro:include filename="../common/gazebo_plugins.xacro"/>
  <xacro:include filename="../common/gazebo_ros2_control.xacro"/>

  <xacro:gz_common_plugins controllers_file="$(arg controllers_file)" enable_sensors="false"/>
  <xacro:gz_six_axis_position_control
    name="GazeboSimSystem"
    initial_positions_file="$(arg initial_positions_file)"/>
</robot>
