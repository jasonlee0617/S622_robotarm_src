<?xml version="1.0"?>
<robot name="case">

  <!-- base plate -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.01"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.01"/>
      </geometry>
    </collision>
  </link>

  <!-- front wall -->
  <link name="wall_front">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0"
               iyy="0.0005" iyz="0.0"
               izz="0.0005"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.01 0.10"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.01 0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- back wall -->
  <link name="wall_back">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0"
               iyy="0.0005" iyz="0.0"
               izz="0.0005"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.01 0.10"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.01 0.10"/>
      </geometry>
    </collision>
  </link>

  <!-- left wall -->
  <link name="wall_left">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0"
               iyy="0.0005" iyz="0.0"
               izz="0.0005"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
         <box size="0.01 0.20 0.10"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
         <box size="0.01 0.20 0.10"/>
      </geometry>
    </collision>
  </link>

  <!-- right wall -->
  <link name="wall_right">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0"
               iyy="0.0005" iyz="0.0"
               izz="0.0005"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
         <box size="0.01 0.20 0.10"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
         <box size="0.01 0.20 0.10"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_front" type="fixed">
    <parent link="base_link"/>
    <child link="wall_front"/>
    <origin xyz="0 -0.1 0.05" rpy="0 0 0"/>
  </joint>

  <joint name="joint_back" type="fixed">
    <parent link="base_link"/>
    <child link="wall_back"/>
    <origin xyz="0 0.1 0.05" rpy="0 0 0"/>
  </joint>

  <joint name="joint_left" type="fixed">
    <parent link="base_link"/>
    <child link="wall_left"/>
    <origin xyz="-0.1 0 0.05" rpy="0 0 0"/>
  </joint>

  <joint name="joint_right" type="fixed">
    <parent link="base_link"/>
    <child link="wall_right"/>
    <origin xyz="0.1 0 0.05" rpy="0 0 0"/>
  </joint>

</robot>
