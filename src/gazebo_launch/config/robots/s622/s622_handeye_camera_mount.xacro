<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find s622_moveit_descriptions)/urdf/camera/camera.xacro"/>

  <xacro:macro name="s622_gazebo_handeye_camera" params="camera_fps:=30 camera_image_width:=1280 camera_image_height:=720">
    <!--
      Gazebo calibration profile uses a clean eye-in-hand visual mount instead
      of replaying a noisy real-world calibration result. The D435 is placed on
      the -Y side of grasp_frame with the optical axis along grasp_frame +Z.
    -->
    <xacro:camera_v0 parent="grasp_frame">
      <origin xyz="0.000 -0.0375 -0.060"
              rpy="0 -1.57079632679 -1.57079632679"/>
    </xacro:camera_v0>

    <xacro:camera_gazebo_v0
      fps="${camera_fps}"
      image_width="${camera_image_width}"
      image_height="${camera_image_height}"/>
  </xacro:macro>
</robot>
