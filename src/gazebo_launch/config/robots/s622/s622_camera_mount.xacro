<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find s622_moveit_descriptions)/urdf/camera/camera.xacro"/>

  <xacro:macro name="s622_gazebo_camera">
    <xacro:property name="PI" value="3.14159274"/>
    <xacro:camera_v0 parent="base_link">
      <origin xyz="0.25 0.7 1.0" rpy="0 ${79*PI/180} ${-PI/2}"/>
    </xacro:camera_v0>
    <xacro:camera_gazebo_v0/>
  </xacro:macro>
</robot>

