<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gazebo_launch</name>
  <version>0.0.0</version>
  <description>Gazebo launch files and demo nodes for robot arm simulation.</description>
  <maintainer email="robot@todo.todo">robot</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <exec_depend>easy_handeye2</exec_depend>
  <exec_depend>hand_eye_calibration</exec_depend>
  <exec_depend>yolov8_grasping</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ros2_aruco</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>yolo_perception</exec_depend>
  <exec_depend>manipulation_common</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
