<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="box_model">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <link name="box_link">
      <!-- 这里的 pose 是模型局部坐标，真正放到桌面高度，
           建议在 world 文件 include 这个模型时再给全局 pose -->
      <pose>0 0 0 0 0 0</pose>

      <gravity>true</gravity>
      <enable_wind>false</enable_wind>

      <inertial>
        <mass>0.08</mass>
        <inertia>
          <ixx>1.2e-5</ixx>
          <iyy>1.2e-5</iyy>
          <izz>1.2e-5</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <!-- 适度阻尼，避免飘得太假 -->
      <velocity_decay>
        <linear>0.08</linear>
        <angular>0.12</angular>
      </velocity_decay>

      <collision name="box_collision">
        <geometry>
          <box>
            <size>0.03 0.03 0.03</size>
          </box>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>0.08</mu>
              <mu2>0.08</mu2>
            </ode>
          </friction>
          <contact>
            <ode/>
          </contact>
        </surface>
      </collision>

      <visual name="box_visual">
        <geometry>
          <box>
            <size>0.03 0.03 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0 1 0 1</ambient>
          <diffuse>0 1 0 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <!-- Gazebo / Ignition 6 内置速度控制系统 -->
    <plugin
      filename="ignition-gazebo-velocity-control-system"
      name="ignition::gazebo::systems::VelocityControl">

      <!-- 默认也是 /model/<model_name>/cmd_vel，这里显式写出来更清楚 -->
      <topic>/model/box_model/cmd_vel</topic>

      <!-- 初始线速度：机体坐标系前向 x -->
      <initial_linear>0.0 0 0</initial_linear>

      <!-- 初始角速度：绕 z 匀速转，形成圆轨迹 -->
      <initial_angular>0 0 0.0</initial_angular>
    </plugin>
  </model>
</sdf>

