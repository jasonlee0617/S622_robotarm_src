<?xml version="1.0" encoding="UTF-8"?>
<robot name="fairino_arm_moveit_descriptions">
    <group name="robot_arm">
        <joint name="j1"/>
        <joint name="j2"/>
        <joint name="j3"/>
        <joint name="j4"/>
        <joint name="j5"/>
        <joint name="j6"/>
        <chain base_link="base_link" tip_link="tool0"/>
    </group>

    
    <group name="hand">
        <joint name="finger1_joint"/>
        <joint name="finger2_joint"/>
    </group>
    <!--GROUP STATES: Purpose: Define a named state for a particular group, in terms of joint values. This is useful to define states like 'folded arms'-->
    <group_state name="pos1" group="robot_arm">
        <joint name="j1" value="-1.6057"/>
        <joint name="j2" value="-1.7279"/>
        <joint name="j3" value=" 1.5184"/>
        <joint name="j4" value="-1.3614"/>
        <joint name="j5" value="-1.5708"/>
        <joint name="j6" value="0"/>
    </group_state>
    <group_state name="pos2" group="robot_arm">
        <joint name="j1" value="0.8606"/>
        <joint name="j2" value="-1.4189"/>
        <joint name="j3" value="1.5465"/>
        <joint name="j4" value="-1.7227"/>
        <joint name="j5" value="-1.5018"/>
        <joint name="j6" value="0"/>
    </group_state>
    <group_state name="verticalpos" group="robot_arm">
        <joint name="j1" value="0"/>
        <joint name="j2" value="-1.5708"/>
        <joint name="j3" value="0"/>
        <joint name="j4" value="0"/>
        <joint name="j5" value="0"/>
        <joint name="j6" value="0"/>
    </group_state>
    <group_state name="open_max" group="hand">
        <joint name="finger1_joint" value="0.0305"/>
        <joint name="finger2_joint" value="-0.0305"/>
    </group_state>
    <group_state name="close" group="hand">
        <joint name="finger1_joint" value="0"/>
        <joint name="finger2_joint" value="0"/>
    </group_state>
    <!--END EFFECTOR: Purpose: Represent information about an end effector.-->
    <end_effector name="TCP" parent_link="tool0" group="hand" parent_group="robot_arm"/>
    <!--VIRTUAL JOINT: Purpose: this element defines a virtual joint between a robot link and an external frame of reference (considered fixed with respect to the robot)-->
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>
    <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->
    <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="upperarm_link" reason="Never"/>
    <disable_collisions link1="finger1" link2="finger2" reason="Default"/>
    <disable_collisions link1="finger1" link2="wrist1_link" reason="Never"/>
    <disable_collisions link1="finger1" link2="wrist2_link" reason="Never"/>
    <disable_collisions link1="finger1" link2="wrist3_link" reason="Adjacent"/>
    <disable_collisions link1="finger2" link2="wrist1_link" reason="Never"/>
    <disable_collisions link1="finger2" link2="wrist2_link" reason="Never"/>
    <disable_collisions link1="finger2" link2="wrist3_link" reason="Adjacent"/>
    <disable_collisions link1="forearm_link" link2="upperarm_link" reason="Adjacent"/>
    <disable_collisions link1="forearm_link" link2="wrist1_link" reason="Adjacent"/>
    <disable_collisions link1="shoulder_link" link2="upperarm_link" reason="Adjacent"/>
    <disable_collisions link1="shoulder_link" link2="wrist1_link" reason="Never"/>
    <disable_collisions link1="wrist1_link" link2="wrist2_link" reason="Adjacent"/>
    <disable_collisions link1="wrist1_link" link2="wrist3_link" reason="Never"/>
    <disable_collisions link1="wrist2_link" link2="wrist3_link" reason="Adjacent"/>
</robot>
