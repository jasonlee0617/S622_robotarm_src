<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>myrobot_mpc_avoidance</name>
  <version>1.0.0</version>
  <description>MPC dynamic obstacle avoidance with acados for Fairino robot</description>
  <maintainer email="jason@example.com">JasonLee</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>pluginlib</depend>
  <depend>ament_index_cpp</depend>
  <depend>myrobot_planning_core</depend>
  <depend>myrobot_planning_ros</depend>
  <depend>manipulation_common</depend>
  <depend>ros_gz_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
