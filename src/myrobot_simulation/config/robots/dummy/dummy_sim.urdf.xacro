<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dummy">
  <!-- Template profile. Enable after the dummy description/config packages exist in this workspace. -->
  <xacro:arg name="initial_positions_file" default="$(find dummy2-gripperv2_moveit_config)/config/initial_positions.yaml"/>
  <xacro:arg name="controllers_file" default="$(find dummy2-gripperv2_moveit_config)/config/ros2_controllers.yaml"/>
  <xacro:arg name="enable_camera" default="false"/>

  <xacro:include filename="$(find dummy2-gripperv2_description)/urdf/dummy2-gripperv2.xacro"/>
  <xacro:include filename="../common/sim_plugins.xacro"/>
  <xacro:include filename="../common/sim_ros2_control.xacro"/>

  <xacro:gz_common_plugins controllers_file="$(arg controllers_file)" enable_sensors="false"/>
  <xacro:gz_six_axis_velocity_control
    name="GazeboSimSystem"
    initial_positions_file="$(arg initial_positions_file)"
    include_gripper="true"/>
</robot>
