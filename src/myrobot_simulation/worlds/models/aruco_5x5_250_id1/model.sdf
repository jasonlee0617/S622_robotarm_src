    <!-- Same free-body velocity controller used by the moving cube target. -->
    <plugin
      filename="ignition-gazebo-velocity-control-system"
      name="ignition::gazebo::systems::VelocityControl">
      <topic>/model/aruco_marker_model/cmd_vel</topic>
      <initial_linear>0.0 0.0 0.0</initial_linear>
      <initial_angular>0.0 0.0 0.0</initial_angular>
    </plugin>
  </model>
