<?xml version="1.0"?>
<sdf version="1.7">
  <model name="aruco_5x5_250_id1">
    <!-- Dynamic so the shared board can receive Gazebo cmd_vel in position-servo demos.
         With gravity disabled it remains stationary in calibration worlds until commanded. -->
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>
    <!-- Keep the model frame aligned with the board geometry.  World spawn
         roll/pitch/yaw are the single source of truth for board orientation. -->
    <link name="board">
      <pose>0 0 0 0 0 0</pose>
      <gravity>false</gravity>
      <velocity_decay>
        <linear>0.08</linear>
        <angular>0.12</angular>
      </velocity_decay>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
        </inertia>
      </inertial>
      <!-- DICT_5X5_250 marker id=1, borderBits=1. Rendered as geometry so Gazebo does not depend on texture/material loading. -->
      <!-- Back-side cells are mirrored in X so cameras viewing the rear face still see the canonical marker, not a mirror image. -->
      <collision name="collision">
        <geometry>
          <box>
            <size>0.09 0.002 0.09</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.08</mu>
              <mu2>0.08</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="white_backing">
        <geometry>
          <box>
            <size>0.09 0.002 0.09</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <visual name="front_black_r0_c0">
