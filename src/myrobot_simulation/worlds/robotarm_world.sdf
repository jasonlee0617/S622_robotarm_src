      </include>
      <pose>0.29 0 0 0 0 1.5708</pose>
    </model>

    <model name="ground_plane">
      <static>true</static>
      <include>
        <uri>model://ground_plane</uri>
      </include>
    </model>

    <include>
      <uri>model://cube</uri>
      <name>cube_model</name>
      <pose>0.2 0.45 1.05 0 0 0</pose>
    </include>
    <include>
      <uri>model://box</uri>
      <name>box_model</name>
      <pose>0.25 0.25 1.04 0 0 0</pose>
    </include>
