<?xml version="1.0"?>
<sdf version="1.6">
  <world name="calibration_table">
    <scene>
      <shadows>true</shadows>
      <ambient>0.8 0.8 0.8 0.8</ambient>
      <background>0.8 0.8 0.8 0.8</background>
    </scene>

    <gui>
      <camera name="user_camera">
        <pose>0.75 -0.75 1.2 0 0.29 2.21</pose>
      </camera>
    </gui>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="table">
      <static>true</static>
      <include>
        <uri>model://table</uri>
      </include>
      <pose>0.29 0 0 0 0 1.5708</pose>
    </model>

    <model name="ground_plane">
      <static>true</static>
      <include>
        <uri>model://ground_plane</uri>
      </include>
    </model>
  </world>
</sdf>
